---
import { socialConfig } from '@constants/site-config';
import { withBase } from '@/i18n/utils';
import { Icon } from 'astro-icon/components';
import { capitalize } from 'es-toolkit';

/**
 * 配置里的社交链接大多指向外部站点（http/https/mailto），少数是站内路径
 * （如 RSS 的 /rss.xml）。站内路径要补部署 base，否则子路径部署会 404；
 * 外部链接必须原样保留。
 */
const resolveSocialUrl = (url: string): string => (url.startsWith('/') ? withBase(url) : url);
---

<!--
  社交图标组（design-spec §6.4）
  28×28 / 圆角 8 / gap 8 / 图标 16px
  默认 --muted-foreground + 1px 边框；hover 转青 + 边框青 + --glow-cyan-sm
  不再使用各平台品牌色（会把赛博配色打散，且品牌色里没有青色）
-->
<div class="flex flex-wrap items-center justify-center gap-2">
  {
    Object.entries(socialConfig).map(([key, config]) => {
      const { url, icon } = config;
      return (
        <a
          class="flex size-7 items-center justify-center rounded-lg border border-border/60 text-muted-foreground transition-[color,border-color,box-shadow] duration-200 ease-in-out hover:border-primary/40 hover:text-primary hover:shadow-[var(--glow-cyan-sm)]"
          data-platform={key}
          href={resolveSocialUrl(url)}
          title={capitalize(key)}
          data-tooltip-interactive="false"
          data-tooltip-placement="top"
          aria-label={capitalize(key)}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name={icon} class="size-4" />
        </a>
      );
    })
  }
</div>
