---
import { icpConfig, siteConfig } from '@constants/site-config';
import { getSiteStats } from '@lib/stats';
import { cn } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, t } from '@/i18n';

interface Props {
  className?: string;
}

const { className } = Astro.props;

const locale = getLocaleFromUrl(Astro.url.pathname);
const stats = await getSiteStats();
const currentYear = new Date().getFullYear();
const startYear = siteConfig?.startYear ?? currentYear;
const tagline = siteConfig?.description;
---

<!--
  页脚（design-spec §6.12）
  · 顶部 1px 青→紫光带
  · 桌面三段：站点信息 / 统计 / 备案；≤768 单列居中
  · 樱花图标换成 6×6 青菱形（pulse 3.2s），reduced-motion 下静止
-->
<footer class={cn('mt-16 md:mt-12', className)}>
  <div class="h-px w-full bg-[linear-gradient(90deg,transparent,hsl(var(--primary)/0.45),hsl(var(--neon-violet)/0.35),transparent)]"></div>
  <div class="cyber-shell flex flex-col gap-6 pt-10 pb-8 md:gap-4 md:items-center md:text-center">
    <div class="flex flex-wrap items-start justify-between gap-6 md:flex-col md:items-center md:gap-4">
      <!-- 左：站点名 + 一句话 -->
      <div class="flex flex-col gap-1">
        <span class="text-[15px] font-semibold text-foreground">{siteConfig.name}</span>
        {tagline && <span class="text-xs text-muted-foreground">{tagline}</span>}
      </div>

      <!-- 中：统计（图标 16px + 数字 13px mono 青 + 单位 11px muted） -->
      <div class="flex flex-wrap items-center gap-3">
        <button
          type="button"
          class="footer-stat"
          title={t(locale, 'footer.totalWordsTitle')}
          aria-label={t(locale, 'footer.totalWordsTitle')}
        >
          <Icon name="ri:file-text-line" class="size-4" />
          <span class="font-mono text-[13px] font-medium tabular-nums text-primary">{stats.formattedWords}</span>
          <span class="text-[11px] text-muted-foreground">{t(locale, 'footer.wordUnit')}</span>
        </button>

        <span aria-hidden="true" class="h-3.5 w-px bg-white/[0.12]"></span>

        <button
          type="button"
          class="footer-stat"
          title={t(locale, 'footer.readingTimeTitle')}
          aria-label={t(locale, 'footer.readingTimeTitle')}
        >
          <Icon name="ri:time-line" class="size-4" />
          <span class="font-mono text-[13px] font-medium tabular-nums text-primary">{stats.formattedTime}</span>
        </button>

        <span aria-hidden="true" class="h-3.5 w-px bg-white/[0.12]"></span>

        <button
          type="button"
          class="footer-stat"
          title={t(locale, 'footer.postCountTitle')}
          aria-label={t(locale, 'footer.postCountTitle')}
        >
          <Icon name="ri:article-line" class="size-4" />
          <span class="font-mono text-[13px] font-medium tabular-nums text-primary">{stats.postCount}</span>
          <span class="text-[11px] text-muted-foreground">{t(locale, 'footer.postUnit')}</span>
        </button>
      </div>

      <!-- 右：备案 -->
      <div class="flex flex-col items-end gap-1 md:items-center">
        {
          icpConfig && (
            <div class="text-xs text-muted-foreground">
              {icpConfig.link ? (
                <a href={icpConfig.link} target="_blank" rel="noopener noreferrer" class="footer-link">
                  {icpConfig.text}
                </a>
              ) : (
                <span>{icpConfig.text}</span>
              )}
            </div>
          )
        }
        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <span class="font-mono">©</span>
          <span class="font-mono tabular-nums">{startYear}</span>
          {
            startYear !== currentYear && (
              <>
                <span class="opacity-60">-</span>
                <span class="font-mono tabular-nums" itemprop="copyrightYear">
                  {currentYear}
                </span>
              </>
            )
          }
          <span aria-hidden="true" class="footer-diamond mx-1"></span>
          <span class="author" itemprop="copyrightHolder">
            {siteConfig.name}
            {siteConfig?.alternate ? `@${siteConfig.alternate}` : ''}
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* 统计按钮：只在 hover 时提亮，不发光（发光配额留给导航/Hero/卡片 hover） */
  .footer-stat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: hsl(var(--muted-foreground));
    transition: color var(--dur-base) var(--ease-in-out);
  }

  .footer-stat:hover {
    color: hsl(var(--foreground));
  }

  /* 6×6 青菱形，替代原樱花图标（§6.12） */
  .footer-diamond {
    width: 6px;
    height: 6px;
    background: hsl(var(--primary));
    transform: rotate(45deg);
    border-radius: 1px;
    animation: footer-diamond-pulse 3.2s ease-in-out infinite;
  }

  @keyframes footer-diamond-pulse {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 0.8;
    }
  }

  /* 链接：hover 转青 + 下划线 0→100% */
  .footer-link {
    position: relative;
    transition: color var(--dur-base) var(--ease-in-out);
  }

  .footer-link:hover {
    color: hsl(var(--primary));
  }

  .footer-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width var(--dur-base) var(--ease-in-out);
  }

  .footer-link:hover::after {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-diamond {
      animation: none;
      opacity: 0.8;
    }
  }
</style>
