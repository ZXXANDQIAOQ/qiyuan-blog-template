---
import { icpConfig, siteConfig } from '@constants/site-config';

interface Props {
  className?: string;
}

const { className } = Astro.props;

const currentYear = new Date().getFullYear();
const startYear = siteConfig?.startYear ?? currentYear;
const years = startYear !== currentYear ? `${startYear}-${currentYear}` : `${currentYear}`;
---

<!--
  页脚（ljj-clone-spec §1.4）
  · 没有传统多列页脚——页面以四边流动光轨收尾
  · 只保留一行 .section-shell 内的 mono 小字注记（版权 + 备案）
-->
<footer class:list={['site-footnote', className]}>
  <div class="section-shell">
    <p class="footnote-line">
      <span>© {years} {siteConfig.name}</span>
      {
        icpConfig &&
        (icpConfig.link ? (
          <a href={icpConfig.link} target="_blank" rel="noopener noreferrer">
            {icpConfig.text}
          </a>
        ) : (
          <span>{icpConfig.text}</span>
        ))
      }
    </p>
  </div>
</footer>

<style>
  .site-footnote {
    padding-block: 28px 36px;
  }

  .footnote-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: hsl(var(--muted-foreground));
  }

  .footnote-line a {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s var(--ease-in-out);
  }

  .footnote-line a:hover {
    color: hsl(var(--primary));
  }
</style>
