---
import type { HomeSiderType } from '@constants/enum';
import { RESERVED_ROUTES } from '@constants/router';
import { configuredSeriesSlugs, enabledSeriesSlugs, routers, siteConfig } from '@constants/site-config';
import { getAllTags, getCategoryList, getPostCount, getSortedPosts } from '@lib/content';
import { getLqipStyle } from '@lib/lqip';
import { cn, filterNavItems } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import { getLocaleFromUrl, localizedPath, resolveNavName, stripLocaleFromPath, t, withBase } from '@/i18n';
import { getContentSiteField } from '@/i18n/content';
import type { BlogSchema } from '@/types/blog';
import Social from './Social.astro';

interface Props {
  type?: HomeSiderType;
  className?: string;
  isDrawer?: boolean;
  frontmatter?: BlogSchema;
}

const locale = getLocaleFromUrl(Astro.url.pathname);
const postCount = await getPostCount(locale);
const { countMap } = await getCategoryList(locale);
const posts = await getSortedPosts(locale);
const tags = getAllTags(posts);

const allTags = Object.entries(tags).map(([tag, count]) => ({ tag, count }));

// 生成唯一 ID 前缀
const uniqueId = `home-info-${Math.random().toString(36).substring(2, 11)}`;
const { className, isDrawer = false } = Astro.props;

// Filter navigation items to exclude disabled series
const filteredRouters = filterNavItems(routers, configuredSeriesSlugs, enabledSeriesSlugs, RESERVED_ROUTES);
const strippedPath = stripLocaleFromPath(Astro.url.pathname);

// 归一化路径用于激活态比较：忽略末尾斜杠（Astro trailingSlash:'ignore' 下
// 页面会以 /drive/ 形式提供，而导航配置里写的是 /drive，严格 === 会失配）
const normalizePath = (p: string | undefined): string => {
  if (!p) return '/';
  const s = p.replace(/\/+$/, '');
  return s === '' ? '/' : s;
};

// 头像路径来自配置（数据层，不含部署前缀），渲染时统一补 base，
// 否则 GitHub Pages 子路径部署下头像会 404。
const avatarSrc = withBase(siteConfig.avatar ?? '/img/avatar.svg');

// 头像尺寸：侧栏 88×88，抽屉内缩到 72×72 以省高度（§6.4 / §6.11）
const avatarSize = isDrawer ? 72 : 88;

// 侧栏菜单项（§6.5）：默认/hover/激活三态，左侧 2px 竖条作为「颜色 + 实心条」双信号
const menuItemClass =
  'group relative flex h-10 w-full items-center gap-2.5 rounded-lg px-3 text-sm font-medium text-muted-foreground transition-colors duration-200 ease-in-out hover:bg-white/[0.04] hover:text-foreground';

const menuItemBarClass =
  'before:absolute before:top-1/2 before:left-0 before:h-5 before:w-0.5 before:-translate-y-1/2 before:scale-y-0 before:rounded-full before:bg-primary/50 before:transition-transform before:duration-200 before:ease-[cubic-bezier(0.25,1,0.5,1)] before:content-[""] group-hover:before:scale-y-100';

const menuItemActiveClass =
  'bg-primary/[0.09] font-semibold text-primary before:scale-y-100 before:bg-primary before:shadow-[0_0_12px_hsl(var(--primary)/0.55)]';

const subItemClass =
  'group relative flex h-9 w-full items-center gap-2 rounded-lg pl-9 pr-3 text-[13px] text-muted-foreground transition-colors duration-200 hover:bg-white/[0.04] hover:text-foreground';

const subItemActiveClass = 'bg-primary/[0.06] font-medium text-primary';
---

<!-- 个人信息卡（§6.4） -->
<div class={cn('flex flex-col', className)} data-home-info-container={uniqueId}>
  <div class="cyber-card flex w-full flex-col items-center">
    <!-- 头像 88×88 / 圆角 20 / 青色描边 + 弱光 -->
    <div class="group relative shrink-0" style={getLqipStyle(siteConfig.avatar ?? '/img/avatar.svg')}>
      <img
        transition:persist="page-home-info-avatar"
        class="max-w-none rounded-[20px] border border-primary/25 object-cover shadow-[0_0_24px_hsl(var(--primary)/0.16)] transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03] group-hover:shadow-[0_0_32px_hsl(var(--primary)/0.28)]"
        style={`width:${avatarSize}px;height:${avatarSize}px`}
        src={avatarSrc}
        alt="站点作者头像"
        loading="eager"
        fetchpriority="high"
        width={avatarSize}
        height={avatarSize}
      />
      <!-- 1px 内描边，把头像压进玻璃卡而不是「贴上去」 -->
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 rounded-[20px] ring-1 ring-inset ring-white/10"
      ></span>
    </div>

    <p class="mt-4 text-lg font-bold tracking-[-0.02em] text-foreground">{siteConfig?.name}</p>
    <p class="mt-2 line-clamp-2 max-w-full text-center text-[13px] leading-[1.7] text-muted-foreground">
      {getContentSiteField(locale, 'description') ?? siteConfig?.description}
    </p>

    <!-- 社交图标：28×28 / 圆角 8 / gap 8（§6.4） -->
    <div class="mt-4 w-full">
      <div class="flex flex-wrap items-center justify-center gap-2">
        {
          /* Social 组件按 §6.4 重写为 28×28 图标按钮 */
        }
        <Social />
      </div>
    </div>

    <!-- 统计区：三列 mono 青色数字（抽屉里去掉以省高度，§6.11） -->
    {
      !isDrawer && (
        <div class="mt-5 grid w-full grid-cols-3 border-t border-border/60 pt-4">
          <a
            href={localizedPath('/', locale)}
            class="group flex flex-col items-center justify-center transition-colors"
            aria-label={t(locale, 'homeInfo.articles')}
          >
            <span class="font-mono text-xl font-bold tabular-nums text-primary transition-[text-shadow] duration-200 group-hover:[text-shadow:0_0_16px_hsl(var(--primary)/0.35)]">
              {postCount}
            </span>
            <span class="mt-1 text-[11px] font-medium tracking-[0.12em] text-muted-foreground uppercase">
              {t(locale, 'homeInfo.articles')}
            </span>
          </a>
          <a
            href={localizedPath('/categories', locale)}
            class="group flex flex-col items-center justify-center border-x border-border/50 transition-colors"
            aria-label={t(locale, 'homeInfo.categories')}
          >
            <span class="font-mono text-xl font-bold tabular-nums text-primary transition-[text-shadow] duration-200 group-hover:[text-shadow:0_0_16px_hsl(var(--primary)/0.35)]">
              {Object.keys(countMap).length}
            </span>
            <span class="mt-1 text-[11px] font-medium tracking-[0.12em] text-muted-foreground uppercase">
              {t(locale, 'homeInfo.categories')}
            </span>
          </a>
          <a
            href={localizedPath('/tags', locale)}
            class="group flex flex-col items-center justify-center transition-colors"
            aria-label={t(locale, 'homeInfo.tags')}
          >
            <span class="font-mono text-xl font-bold tabular-nums text-primary transition-[text-shadow] duration-200 group-hover:[text-shadow:0_0_16px_hsl(var(--primary)/0.35)]">
              {allTags?.length ?? 0}
            </span>
            <span class="mt-1 text-[11px] font-medium tracking-[0.12em] text-muted-foreground uppercase">
              {t(locale, 'homeInfo.tags')}
            </span>
          </a>
        </div>
      )
    }
  </div>

  <!-- 侧栏导航菜单（§6.5）：去掉粉色胶囊按钮，回到「左条 + 青底」的克制激活态 -->
  <nav class="mt-4 flex w-full flex-col gap-1" aria-label={t(locale, 'drawer.navMenu')}>
    {
      filteredRouters.map((item, index) => {
        const displayName = resolveNavName(item.nameKey, item.name, locale);
        if (item.children?.length) {
          const collapseId = `${uniqueId}-collapse-${index}`;
          const childIsActive = item.children.some((c) => c.path && normalizePath(c.path) === normalizePath(strippedPath));
          return (
            <div class="flex w-full flex-col" data-collapsible>
              <button
                class={cn(menuItemClass, menuItemBarClass, 'justify-start', childIsActive && menuItemActiveClass)}
                data-collapse-trigger={collapseId}
                aria-expanded={childIsActive ? 'true' : 'false'}
                aria-current={childIsActive ? 'true' : undefined}
                aria-label={t(locale, 'common.menuLabel', { name: displayName })}
                type="button"
              >
                {item.icon && <Icon name={item.icon} class="size-4 shrink-0" />}
                <span class="grow text-left">{displayName}</span>
                <Icon
                  name="ri:arrow-down-s-line"
                  class="size-4 shrink-0 transition-transform duration-200"
                  data-collapse-icon={collapseId}
                  style={childIsActive ? 'transform: rotate(180deg)' : undefined}
                />
              </button>
              <div class={cn('w-full', childIsActive ? '' : 'collapse-hidden')} data-collapse-content={collapseId}>
                <div class="flex flex-col gap-0.5 py-1">
                  {item.children.map((child) => {
                    const childName = resolveNavName(child.nameKey, child.name, locale);
                    const childUrl = child.path ? localizedPath(child.path, locale) : child.path;
                    const childActive = child.path ? normalizePath(child.path) === normalizePath(strippedPath) : false;
                    return (
                      <a
                        href={childUrl}
                        aria-current={childActive ? 'page' : undefined}
                        class:list={[subItemClass, childActive && subItemActiveClass]}
                      >
                        {child.icon && <Icon name={child.icon} class="size-3.5 shrink-0" />}
                        {childName}
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          );
        }
        const itemUrl = item.path ? localizedPath(item.path, locale) : item.path;
        const isActive = item.path ? normalizePath(item.path) === normalizePath(strippedPath) : false;
        return (
          <a
            href={itemUrl}
            aria-current={isActive ? 'page' : undefined}
            class:list={[menuItemClass, menuItemBarClass, isActive && menuItemActiveClass]}
          >
            {item.icon && <Icon name={item.icon} class="size-4 shrink-0" />}
            {displayName}
          </a>
        );
      })
    }
  </nav>
</div>

<style>
  /* 折叠动画使用 CSS Grid 技巧实现平滑的高度过渡 */
  [data-collapse-content] {
    display: grid;
    grid-template-rows: 1fr;
  }

  [data-collapse-content] > div {
    min-height: 0;
    overflow: hidden;
  }

  [data-collapse-content].collapse-hidden {
    grid-template-rows: 0fr;
  }

  /* 只在用户未设置 reduce-motion 时应用动画 */
  @media (prefers-reduced-motion: no-preference) {
    [data-collapse-content] {
      transition: grid-template-rows 0.3s ease;
    }
  }
</style>
<script>
  let collapseMutationObserver: MutationObserver | null = null;

  function initCollapsible() {
    // 找到所有 HomeInfo 容器
    const containers = document.querySelectorAll('[data-home-info-container]');

    containers.forEach((container) => {
      const triggers = container.querySelectorAll('[data-collapse-trigger]');

      triggers.forEach((trigger) => {
        const targetId = trigger.getAttribute('data-collapse-trigger');
        if (!targetId) return;

        // 检查是否已经初始化过
        if (trigger.hasAttribute('data-initialized')) return;
        trigger.setAttribute('data-initialized', 'true');

        // 在当前容器内查找对应的元素
        const content = container.querySelector(`[data-collapse-content="${targetId}"]`) as HTMLElement;
        const icon = trigger.querySelector(`[data-collapse-icon="${targetId}"]`) as HTMLElement;

        if (!content || !icon) return;

        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

          if (isExpanded) {
            // 折叠
            content.classList.add('collapse-hidden');
            icon.style.transform = 'rotate(0deg)';
            trigger.setAttribute('aria-expanded', 'false');
          } else {
            // 展开
            content.classList.remove('collapse-hidden');
            icon.style.transform = 'rotate(180deg)';
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });
    });
  }

  function cleanupObserver() {
    if (collapseMutationObserver) {
      collapseMutationObserver.disconnect();
      collapseMutationObserver = null;
    }
  }

  function setupObserver() {
    // 先清理旧的观察器
    cleanupObserver();

    // 支持 MobileDrawer 延迟加载
    collapseMutationObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.addedNodes.length) {
          setTimeout(initCollapsible, 100);
        }
      });
    });

    collapseMutationObserver.observe(document.body, {
      childList: true,
      subtree: true,
    });
  }

  // 初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initCollapsible();
      setupObserver();
    });
  } else {
    initCollapsible();
    setupObserver();
  }

  // 支持 Astro 的视图过渡
  document.addEventListener('astro:page-load', () => {
    initCollapsible();
    setupObserver();
  });

  // 页面切换前清理观察器
  document.addEventListener('astro:before-swap', cleanupObserver);
</script>
