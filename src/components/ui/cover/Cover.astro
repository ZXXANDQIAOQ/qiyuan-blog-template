---
import InteractiveBg from '@components/effects/InteractiveBg.astro';
import { siteConfig } from '@constants/site-config';
import { getPostCount } from '@lib/content';
import { getPostReadingTime } from '@lib/content/posts';
import { displayDate } from '@lib/date';
import { Icon } from 'astro-icon/components';
import type { BlogPost } from 'types/blog';
import { getLocaleFromUrl, t, withBase } from '@/i18n';
import { getContentSiteField } from '@/i18n/content';

export interface CoverProps {
  data?: BlogPost;
  title?: string;
}

const { data, title } = Astro.props as CoverProps;

const { date, updated, title: dataTitle, draft } = data?.data ?? {};

const readState = data ? getPostReadingTime(data) : null;
const isDraft = import.meta.env.DEV && draft === true;

const locale = getLocaleFromUrl(Astro.url.pathname);

const siteSubtitle = getContentSiteField(locale, 'subtitle') ?? siteConfig?.subtitle;
const postCount = await getPostCount(locale);

/**
 * 三种变体（design-spec §6.3 / §5.1 / §5.2 / §5.3）
 * - post：文章详情页，160px，面包屑 + 40px 标题 + 元信息 + 复制链接
 * - title：列表/归档/分类/标签页，220px，单标题
 * - home：首页，320px，eyebrow + 超大主标（编辑部风 clamp 3–5rem）+ 副标 + 1px 分隔线
 */
const variant = data ? 'post' : title ? 'title' : 'home';
---

<!--
  Hero Banner（编辑部极简风，参考 ljj.world）
  三层背景：暖灰纯色底（--hero-bg）/ 海报纹理（opacity .08 + 灰阶）/ 噪点 / 交互背景
  · 双色光晕层与 32px 网格层已随「编辑部风」移除（纯色底 + 1px 细线，不要网格底纹）
  · 全站不允许「文字发光」，H1 已去除 glow
-->
<header
  class="cyber-hero relative z-0 flex w-full overflow-hidden"
  data-variant={variant}
  transition:name="page-cover-banner"
>
  <!-- 背景层 1：暖灰纯色底（编辑部风，走 --hero-bg） -->
  <div class="absolute inset-0" style="background: var(--hero-bg);" aria-hidden="true"></div>

  <!-- 背景层 2：海报降级为纹理（opacity .08 + grayscale + luminosity），≤768 整层隐藏 -->
  <div class="hero-poster pointer-events-none absolute inset-0" aria-hidden="true">
    <picture>
      <source srcset={withBase('/img/top-poster.webp')} type="image/webp" />
      <img
        src={withBase('/img/top-poster.jpg')}
        alt=""
        class="h-full w-full object-cover opacity-[0.08] grayscale contrast-[1.15] mix-blend-luminosity"
        fetchpriority="low"
        decoding="async"
        loading="eager"
      />
    </picture>
  </div>

  <!-- 背景层 3：噪点 -->
  <div class="cyber-noise absolute inset-0" aria-hidden="true"></div>

  <!-- 背景层 4：交互式流体噪声 + 点阵格子 -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <InteractiveBg />
  </div>

  <!--
    右侧装饰同心圆：允许循环发光/旋转的三处之一（rotate 90s，无闪烁）

    ⚠️ 断点是**反的**，改之前先看这里：本项目 Tailwind v4 的 tablet/md/xs 是
    max-width 语义（tablet = ≤992），不是常见的 min-width。原来写 `hidden
    ... tablet:block` 的本意是「桌面才显示」，实际效果恰好相反——1440 下隐藏，
    390 下反而挂一个 300px 的大圆在右边（实测右边缘越界到 395）。
    改成 `block ... tablet:hidden`：>992 显示，≤992 收起。
    它只是装饰，移动端本来也没有空间承载 300px 圆环。
  -->
  <div class="hero-orbit pointer-events-none absolute top-1/2 right-[6%] block size-[300px] -translate-y-1/2 tablet:hidden" aria-hidden="true">
    <span class="orbit-ring" style="width:100%;height:100%"></span>
    <span class="orbit-ring" style="width:75%;height:75%"></span>
    <span class="orbit-ring" style="width:50%;height:50%"></span>
    <span class="orbit-ring" style="width:25%;height:25%"></span>
  </div>

  <!-- 内容：左对齐，与主栏标题形成同一条阅读轴线（padding-top 让出吸顶导航的高度） -->
  <div class="hero-inner relative z-10 flex w-full items-center">
    <div class="cyber-shell flex w-full flex-col items-start">
      {
        variant === 'post' ? (
          <>
            <h1 class="word-break max-w-[min(100%,26ch)] text-[clamp(26px,3.4vw+12px,40px)] leading-[1.1] font-bold tracking-[-0.015em] text-foreground">
              {dataTitle ?? title}
            </h1>
            <div class="mt-3 flex flex-wrap items-center gap-3 font-mono text-xs font-medium tracking-[0.06em] text-muted-foreground uppercase">
              {date && <span>{t(locale, 'post.publishedAt', { date: displayDate.datetime(date)! })}</span>}
              {updated && (
                <>
                  <span aria-hidden="true" class="h-3 w-px bg-[hsl(var(--border))]" />
                  <span>{t(locale, 'post.updatedAt', { date: displayDate.datetime(updated)! })}</span>
                </>
              )}
              <span aria-hidden="true" class="h-3 w-px bg-[hsl(var(--border))]" />
              <span>{t(locale, 'post.wordCount', { count: readState?.words ?? 0 })}</span>
              <span aria-hidden="true" class="h-3 w-px bg-[hsl(var(--border))]" />
              <span>{readState?.text}</span>
              {isDraft && (
                <span class="inline-flex items-center gap-1 border border-[hsl(var(--primary)/0.3)] bg-[hsl(var(--primary)/0.08)] px-2 py-0.5 text-[11px] text-[hsl(var(--primary))] normal-case">
                  <Icon name="ri:file-edit-line" class="size-3" />
                  {t(locale, 'post.draft')}
                </span>
              )}
            </div>
            <button
              type="button"
              class="copy-link-btn absolute right-[var(--page-pad-x)] bottom-6 hidden items-center gap-1.5 text-muted-foreground transition-colors duration-200 hover:text-primary tablet:flex"
              aria-label={t(locale, 'cover.copyLink')}
              title={t(locale, 'cover.copyLink')}
              onclick="navigator.clipboard.writeText(window.location.href)"
            >
              <Icon name="ri:link" class="size-[18px]" />
            </button>
          </>
        ) : variant === 'title' ? (
          <h1 class="word-break max-w-[min(100%,30ch)] text-[clamp(2.25rem,4vw+8px,3.5rem)] leading-[1.05] font-bold tracking-[-0.015em] text-foreground">
            {title}
          </h1>
        ) : (
          <>
            <p class="flex items-center gap-2 font-mono text-xs font-medium tracking-[0.18em] text-primary uppercase">
              <span>{siteConfig?.alternate}</span>
              <span aria-hidden="true" class="text-muted-foreground/50">│</span>
              <span class="text-muted-foreground normal-case">
                {postCount} {t(locale, 'footer.postUnit')}
              </span>
            </p>
            <h1 class="mt-4 max-w-[min(100%,16ch)] text-[clamp(3rem,5vw,5rem)] leading-[0.95] font-bold tracking-[-0.01em] text-foreground [font-weight:730]">
              {siteConfig?.title}
            </h1>
            {siteSubtitle && (
              <p class="hero-subtitle mt-4 max-w-[46ch] text-[15px] leading-[1.7] text-muted-foreground">{siteSubtitle}</p>
            )}
            <hr class="hero-rule mt-6" aria-hidden="true" />
          </>
        )
      }
    </div>
  </div>

  <!-- 底边 1px 细线（编辑部网格感：纯色细线，不用渐变） -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px"
    style="background: hsl(var(--border));"
    aria-hidden="true">
  </div>
</header>

<style>
  /* 高度五档（§6.3 / §8） */
  .cyber-hero {
    height: 320px;
  }

  /* 吸顶导航是透明浮层，内容必须让出 --nav-h，否则移动端会与汉堡按钮打架 */
  .hero-inner {
    padding-top: var(--nav-h);
  }

  @media (max-width: 480px) {
    /* 152px 的 Hero 里 56px 占掉 37%，标题会与 eyebrow 贴死，压到 44px */
    .hero-inner {
      padding-top: 44px;
    }
  }

  /*
   * 编辑部风 1px 分隔线：home 变体标题区下方的细线，配合底边 1px 细线形成网格感
   */
  .hero-rule {
    width: 100%;
    border: none;
    border-bottom: 1px solid hsl(var(--border));
  }

  /*
   * 海报只当纹理：右侧压掉插画主体（人物轮廓/发丝/翼状结构一清晰就不像纹理了），
   * 左侧保留可见的网格与噪点质感。数值（0.12 / grayscale / luminosity）不动，只调分布。
   */
  .hero-poster::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--hero-poster-fade);
  }

  @media (max-width: 1479px) {
    .cyber-hero {
      height: 280px;
    }
  }

  @media (max-width: 992px) {
    .cyber-hero {
      height: 220px;
    }
  }

  @media (max-width: 768px) {
    .cyber-hero {
      height: 180px;
    }

    /* 移动端只保留底 + 噪点（省流量） */
    .hero-poster {
      display: none;
    }

    /* 180px 装不下 eyebrow + 标题 + 副标，副标让位给标题 */
    .hero-subtitle,
    .hero-rule {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .cyber-hero {
      height: 152px;
    }
  }

  /* 文章页变体 160px */
  .cyber-hero[data-variant='post'] {
    height: 160px;
  }

  @media (max-width: 480px) {
    .cyber-hero[data-variant='post'] {
      height: 152px;
    }
  }

  /* 装饰同心圆：恬谧版改为 7s 呼吸（缩放微动，无旋转无闪烁） */
  .hero-orbit {
    border: 1.5px solid hsl(var(--primary) / 0.16);
    border-radius: 0;
    box-shadow: inset 0 0 0 52px rgba(255, 255, 255, 0.28);
    animation: hero-orbit-breathe 7s ease-in-out infinite;
  }

  .orbit-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: 1.5px solid hsl(var(--primary) / 0.1);
    border-radius: 0;
  }

  @keyframes hero-orbit-breathe {
    0%,
    100% {
      transform: translateY(-50%) scale(1);
      opacity: 0.8;
    }
    50% {
      transform: translateY(-50%) scale(1.035);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orbit {
      animation: none;
    }
  }
</style>
