---
/**
 * 分类列表 —— design-spec §5.4「两列分组卡」
 *
 * 结构：CSS Grid 两列（≤768 单列），每个格子 = 「一级分类行 + 它的子分类列表」。
 *
 * 为什么是 Grid 而不是旧版的 flex column 树：
 *   旧版把所有层级塞进一列，靠 62px 圆点竖条 + 虚线底边表达层级，
 *   8 个分类就要竖向滚一整屏。两列分组让「一级分类」在横向成为并列的
 *   视觉单位，一屏能扫完；层级改由 1px 真实竖线表达（见 SubCategory）。
 *
 * 为什么分组内不再包一层「卡」：
 *   §2.1 规定页面主体永远是最暗一档、浮起来的才变亮。给分组加底色等于
 *   凭空造出 N 个亮色块，与「整页只有一处冷光源」的方向相反。分组感
 *   完全由 24px 粗体标题 + 底部 1px --border + 32px 列间距建立。
 *
 * 发光：零发光。hover 只有「一级行标题变青 / 二级行竖线变青」两处（§2.5）。
 *
 * 可访问性：区块用 aria-label 而不是 sr-only 标题。面包屑最后一项已经写着
 * 「共 N 个分类」，再放一个同名可见/隐藏标题会让读屏连续念两遍同一句话；
 * aria-label 只在用户主动跳进这个 region 时才播报，不占用正文朗读顺序。
 * 也不用可见的 26px Divider 标题 —— Hero 的 h1 就是「所有分类」，重复。
 */
import { buildCategoryPath, type Category, translateCategoryName } from '@lib/content';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import CategoryTitle from './CategoryTitle.astro';
import SubCategory from './SubCategory.astro';

interface Props {
  categories: Category[];
  countMap: Record<string, number>;
  /** 分类总数（含各级子分类）。不传则按 categories 递归数一遍。 */
  totalCount?: number;
}

const { categories, countMap, totalCount } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);

/** 递归数分类总数：父组件传值时直接用，省一次遍历 */
function countAll(list: Category[]): number {
  return list.reduce((sum, item) => sum + 1 + (item.children?.length ? countAll(item.children) : 0), 0);
}

const count = totalCount ?? countAll(categories);
---

<section
  class="cat-list"
  aria-label={`${t(locale, 'category.allCategories')}，${t(locale, 'category.totalCategories', { count })}`}
>
  <ul class="cat-groups">
    {
      categories.map((category) => (
        <li class="cat-groups__item">
          <CategoryTitle
            title={translateCategoryName(category.name, locale)}
            count={countMap[category.name] ?? 0}
            href={localizedPath(buildCategoryPath(category.name), locale)}
          />

          {category.children?.length ? (
            <ul class="cat-subs">
              {category.children.map((child) => (
                <SubCategory category={child} parentNames={[category.name]} countMap={countMap} />
              ))}
            </ul>
          ) : null}
        </li>
      ))
    }
  </ul>
</section>
