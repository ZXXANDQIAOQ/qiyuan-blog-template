---
/**
 * 分页器 —— design-spec §6.17
 *
 * 页码 36×36 / 圆角 8 / 13px mono；当前页 `bg primary/0.12` + 青字 + 青边 + 下缘 2px 青条。
 * 上一页 / 下一页 `padding 0 14px`、高 36。
 *
 * 注意：本次上线 5 篇 < pageSize 10，分页器在首页与 /posts 都不会渲染。
 * 这里**没有**任何「隐藏」的硬编码逻辑 —— 是否渲染由调用方的 `showPaginator`
 * 和 `page.lastPage` 决定，样式按规范备好，文章变多时自动生效。
 *
 * ≤480：只保留「上一页 / 当前页码 / 下一页」，中间页码由 CSS 折叠，
 * 不写第二套 JS 分支。
 */
import type { Page } from 'astro';
import type { BlogPost } from 'types/blog';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';

interface Props {
  page: Page<BlogPost>;
  /** 分页基础路径，默认 `/posts` */
  baseUrl?: string;
  /** 首页分页：第 1 页回到 `/` 而不是 `/posts` */
  isHomePage?: boolean;
}

const locale = getLocaleFromUrl(Astro.url.pathname);
const defaultBaseUrl = localizedPath('/posts', locale);
const { page, baseUrl = defaultBaseUrl, isHomePage = false } = Astro.props as Props;

const homeUrl = localizedPath('/', locale);
const total = page.lastPage;
const current = page.currentPage;

function getPageUrl(pageNum: number): string {
  if (pageNum === 1) return isHomePage ? homeUrl : baseUrl;
  return `${baseUrl}/${pageNum}`;
}

/**
 * 页码序列：总页数 ≤7 全展开；否则「首页 … 当前±1 … 末页」
 * 例：1 … 4 5 6 … 12
 */
function buildNumbers(): (number | 'gap')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

  const items: (number | 'gap')[] = [1];
  if (current > 4) items.push('gap');
  for (let n = Math.max(2, current - 1); n <= Math.min(total - 1, current + 1); n += 1) items.push(n);
  if (current < total - 3) items.push('gap');
  items.push(total);
  return items;
}

const items = buildNumbers();
---

{
  total > 1 && (
    <nav class="paginator" aria-label={t(locale, 'pagination.nav')}>
      {/* 上一页 */}
      {page.url.prev ? (
        <a class="pg-nav" href={page.url.prev} rel="prev">
          <svg class="pg-nav__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {t(locale, 'pagination.prev')}
        </a>
      ) : (
        <span class="pg-nav pg-nav--disabled" aria-disabled="true">
          <svg class="pg-nav__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {t(locale, 'pagination.prev')}
        </span>
      )}

      {/* 页码（≤480 由 CSS 折叠，只留当前页） */}
      <ul class="pg-numbers">
        {items.map((item) =>
          item === 'gap' ? (
            <li class="pg-gap" aria-hidden="true">
              …
            </li>
          ) : item === current ? (
            <li>
              <span class="pg-num pg-num--current" aria-current="page" aria-label={t(locale, 'pagination.currentPage', { page: current })}>
                {item}
              </span>
            </li>
          ) : (
            <li>
              <a class="pg-num" href={getPageUrl(item)} aria-label={t(locale, 'pagination.page', { page: item })}>
                {item}
              </a>
            </li>
          ),
        )}
      </ul>

      {/* 下一页 */}
      {page.url.next ? (
        <a class="pg-nav" href={page.url.next} rel="next">
          {t(locale, 'pagination.next')}
          <svg class="pg-nav__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ) : (
        <span class="pg-nav pg-nav--disabled" aria-disabled="true">
          {t(locale, 'pagination.next')}
          <svg class="pg-nav__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      )}
    </nav>
  )
}

<style>
  .paginator {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 32px;
  }

  /* ---- 页码 -------------------------------------------------------------- */
  .pg-numbers {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pg-num {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    color: hsl(var(--muted-foreground));
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition:
      color var(--dur-base) var(--ease-in-out),
      border-color var(--dur-base) var(--ease-in-out),
      background-color var(--dur-base) var(--ease-in-out);
  }

  a.pg-num:hover {
    border-color: hsl(var(--primary) / 0.45);
    color: hsl(var(--primary));
  }

  /* 当前页：底色 + 青字 + 青边 + 下缘 2px 青条
     （发光不是唯一信号 —— 这里同时有底色、文字色、边框色、实心条四项变化，§9.1 条款 3） */
  .pg-num--current {
    border-color: hsl(var(--primary) / 0.45);
    background: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
    font-weight: 600;
  }

  .pg-num--current::after {
    content: "";
    position: absolute;
    inset-inline: 6px;
    bottom: -1px;
    height: 2px;
    border-radius: 1px;
    background: hsl(var(--primary));
  }

  .pg-gap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 36px;
    color: hsl(var(--muted-foreground));
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1;
  }

  /* ---- 上一页 / 下一页 --------------------------------------------------- */
  .pg-nav {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    color: hsl(var(--muted-foreground));
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    transition:
      color var(--dur-base) var(--ease-in-out),
      border-color var(--dur-base) var(--ease-in-out),
      background-color var(--dur-base) var(--ease-in-out);
  }

  a.pg-nav:hover {
    border-color: hsl(var(--primary) / 0.45);
    background: hsl(var(--primary) / 0.06);
    color: hsl(var(--primary));
  }

  .pg-nav--disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pg-nav__icon {
    width: 14px;
    height: 14px;
    flex: none;
  }

  /* ---- 触控区补足 44×44（≤992，§8.1 / §9.3） ----------------------------- */
  @media (max-width: 992px) {
    .pg-num,
    .pg-nav {
      position: relative;
    }

    .pg-num::before,
    .pg-nav::before {
      content: "";
      position: absolute;
      inset: -4px;
    }
  }

  /* ---- ≤480：只留「上一页 / 当前 / 下一页」 ------------------------------ */
  @media (max-width: 480px) {
    .pg-gap,
    .pg-numbers > li:not(:has(.pg-num--current)) {
      display: none;
    }

    .pg-nav {
      padding: 0 12px;
    }
  }
</style>
