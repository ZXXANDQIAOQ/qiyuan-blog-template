---
/**
 * Studio 后台的独立布局
 *
 * 刻意不复用站点主 Layout：后台不需要导航栏、页脚、搜索、浮动按钮这些
 * 面向访客的东西，而且要避免被 Pagefind 索引。这里只带最基础的
 * 主题变量与字体，保持与站点观感一致即可。
 *
 * meta description 由页面 prop 传入（content-plan.md §一），
 * 三页通用；后台不输出 og/twitter meta（content-plan.md §二.5）。
 */
interface Props {
  title?: string;
  description?: string;
}

const { title = '内容后台', description = '烁烁内容后台登录页，仅站长使用。' } = Astro.props;

import { withBase } from '@/i18n/utils';
import '@styles/index.css';
---

<!doctype html>
<html lang="zh-CN" class="vertical-scrollbar">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        // 恬谧版唯一主题：与主站 Layout 保持一致，锁定浅色并清掉历史深色偏好
        var root = document.documentElement;
        root.classList.remove('dark');
        root.dataset.theme = 'light';
        try {
          delete localStorage.theme;
        } catch (e) {}
      })();
    </script>
    <style is:global>
      html,
      body {
        height: 100%;
      }

      body {
        margin: 0;
        /* 恬谧主界面：暖奶油 → 雾紫对角渐变，与主站一致 */
        background:
          linear-gradient(160deg, #ffffd0 0%, #f4efff 55%, #d2cdff 100%) fixed,
          var(--gradient-bg-start, #ffffd0);
        background-attachment: fixed;
        color: var(--color-text-primary, #2c2a3e);
        font-family: var(--font-sans, system-ui, -apple-system, 'Segoe UI', sans-serif);
        font-size: 14px;
        line-height: 1.6;
      }

      html.dark body {
        color-scheme: dark;
      }

      /* ---- 组件样式（恬谧版）---- */

      /* 基础按钮（次要） */
      .studio-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 14px;
        /* 触控目标 ≥44px（design-spec.md §7.2） */
        min-height: 44px;
        border-radius: 12px;
        border: 1px solid rgba(122, 111, 214, 0.22);
        background: var(--color-background-primary, rgba(255, 255, 255, 0.85));
        color: inherit;
        font-family: inherit;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease,
          opacity 0.15s ease;
      }

      .studio-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        border-color: rgba(122, 111, 214, 0.4);
        box-shadow: 0 6px 18px rgba(122, 111, 214, 0.14);
      }

      .studio-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }

      /* 主要按钮（登录、保存、写新文章）—— 雾紫实底 */
      .studio-btn-primary {
        background: linear-gradient(135deg, #8d84e8, #7a6fd6);
        color: #fff;
        border-color: transparent;
      }

      /* 危险按钮（删除） */
      .studio-btn-danger {
        color: var(--color-text-danger, #a8433f);
        border-color: rgba(168, 67, 63, 0.35);
      }

      /* 文本输入、textarea 通用 */
      .studio-input {
        width: 100%;
        box-sizing: border-box;
        padding: 8px 12px;
        /* 触控目标 ≥44px（design-spec.md §7.2） */
        min-height: 44px;
        border-radius: 12px;
        border: 1px solid rgba(122, 111, 214, 0.22);
        background: var(--color-background-primary, rgba(255, 255, 255, 0.85));
        color: inherit;
        font-family: inherit;
        font-size: 14px;
        outline: none;
        transition:
          border-color 0.15s ease,
          box-shadow 0.15s ease;
      }

      .studio-input:focus {
        border-color: rgba(122, 111, 214, 0.55);
        box-shadow: 0 0 0 3px rgba(122, 111, 214, 0.12);
      }

      /* Markdown 编辑区（等宽、可拉伸） */
      .studio-input-mono {
        font-family: var(--font-mono, 'SF Mono', Consolas, monospace);
        font-size: 13px;
        line-height: 1.7;
        resize: vertical;
        min-height: 46vh;
      }

      /* 复选框 / 开关（草稿、置顶） */
      .studio-checkbox {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        cursor: pointer;
      }

      .studio-checkbox input[type='checkbox'] {
        width: 16px;
        height: 16px;
        accent-color: #7a6fd6;
      }

      /* 文件上传按钮（包裹隐藏 input） */
      .studio-upload-btn {
        flex-shrink: 0;
        cursor: pointer;
      }

      /* 状态徽章 */
      .studio-badge {
        display: inline-flex;
        align-items: center;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 12px;
        line-height: 1.5;
        border: 0.5px solid currentColor;
        opacity: 0.7;
      }

      .studio-badge-draft {
        color: var(--color-text-warning, #b8860b);
      }

      .studio-badge-saving {
        color: #7a6fd6;
      }

      .studio-badge-saved {
        color: var(--color-text-success, #2d7a3c);
      }

      .studio-badge-error {
        color: var(--color-text-danger, #a8433f);
      }

      .studio-badge-uploading {
        color: #7a6fd6;
      }

      /* 登录卡 */
      .studio-card-login {
        background: rgba(255, 255, 255, 0.88);
        border: 1px solid rgba(122, 111, 214, 0.18);
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 18px 48px rgba(122, 111, 214, 0.16);
        max-width: 380px;
      }

      /* 文章列表行 / 通用卡片 */
      .studio-card {
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(122, 111, 214, 0.16);
        border-radius: 14px;
        padding: 14px;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .studio-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 22px rgba(122, 111, 214, 0.12);
      }

      /* 编辑器面板 */
      .studio-panel {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(122, 111, 214, 0.16);
        border-radius: 14px;
      }

      /* 错误横幅 */
      .studio-banner-error {
        background: rgba(168, 67, 63, 0.08);
        color: var(--color-text-danger, #a8433f);
        border-radius: 12px;
        padding: 12px;
        font-size: 13px;
        margin: 12px 16px 0;
      }

      /* 信息横幅 */
      .studio-banner-info {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(122, 111, 214, 0.3);
        border-radius: 12px;
        padding: 12px;
        font-size: 13px;
      }

      /* ---- Markdown 工具栏（编辑器）---- */
      .studio-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px;
      }

      .studio-tb-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 34px;
        padding: 0 8px;
        border-radius: 10px;
        border: 1px solid transparent;
        background: transparent;
        color: inherit;
        font-family: inherit;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        opacity: 0.75;
        transition:
          background 0.15s ease,
          color 0.15s ease,
          opacity 0.15s ease;
      }

      .studio-tb-btn:hover {
        background: rgba(122, 111, 214, 0.12);
        color: #6a5fd0;
        opacity: 1;
      }

      .studio-tb-btn:focus-visible {
        outline: 2px solid #7a6fd6;
        outline-offset: 2px;
      }

      .studio-tb-btn svg {
        width: 17px;
        height: 17px;
      }

      /* 顶部栏（编辑器） */
      .studio-topbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 0.5px solid var(--color-border-tertiary, rgba(0, 0, 0, 0.12));
        padding: 12px 16px;
      }

      @media (min-width: 640px) {
        .studio-topbar {
          padding: 12px 24px;
        }
      }

      /* ---- 无障碍：焦点环（design-spec.md §8.1）---- */
      .studio-btn:focus-visible,
      .studio-input:focus-visible,
      .studio-checkbox input:focus-visible {
        outline: 2px solid #7a6fd6;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
