---
/**
 * 归档页 —— ljj-clone-spec §5（/archives）
 *
 * ljj 子页同构：topline（`05 / ARCHIVE —— 虚线 —— 共 N 篇`）+ 标题行 +
 * 按年份分组的行式索引列表（time / 标题两列，行间 1px 线，直角无发光）。
 *
 * 时间线实现要点保留：
 *   1. 竖线画在容器 .tl 的 ::before 上（一条通线，不按年份分段）；
 *   2. 年份节点是 1px 描边的直角小方块（ljj 无圆形节点、无发光）；
 * 旧的青色发光节点 / hover 青点换成本规格的锈红 + surface 行背景。
 */
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import { getPostSlug, getSortedPosts } from '@lib/content';
import { displayDate } from '@lib/date';
import { encodeSlug } from '@lib/route';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import '@styles/components/console-pages.css';

const locale = getLocaleFromUrl(Astro.url.pathname);
const posts = await getSortedPosts(locale);

// 按年份分组。getSortedPosts 已按日期倒序，同一年内新的在上。
const postsByYear = posts.reduce(
  (acc, post) => {
    const year = new Date(post.data.date).getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, typeof posts>,
);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title={`${t(locale, 'archives.title')} | ${siteConfig.title}`} description={t(locale, 'archives.title')}>
  <section class="arch-console">
    <div class="section-shell">
      <header class="console-topline">
        <span class="console-topline-index">05 / ARCHIVE</span>
        <span class="console-topline-rule"></span>
        <span class="console-topline-copy">EVERYTHING SO FAR</span>
        <span class="console-topline-status"><i></i>{t(locale, 'archives.totalPosts', { count: posts.length })}</span>
      </header>

      <div class="console-heading arch-heading">
        <h1>{t(locale, 'archives.title')}</h1>
        <span class="console-count"><b>{posts.length}</b></span>
      </div>

      <ol class="tl">
        {
          years.map((year) => (
            <li class="tl__year">
              <div class="tl__year-head">
                <h2 class="tl__year-title">{year}</h2>
                <span class="tl__year-count">{t(locale, 'archives.totalPosts', { count: postsByYear[Number(year)].length })}</span>
              </div>

              <ol class="tl__entries">
                {postsByYear[Number(year)].map((post) => (
                  <li class="tl__entry">
                    <a class="tl__link" href={localizedPath(`/post/${encodeSlug(getPostSlug(post))}`, locale)} data-astro-prefetch="hover">
                      <time class="tl__date" datetime={post.data.date.toISOString()}>
                        {displayDate.date(post.data.date).slice(5).replace('-', '.')}
                      </time>
                      <span class="tl__title">{post.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .arch-console {
    padding-block: 22px 88px;
  }

  .console-topline {
    margin-bottom: clamp(36px, 6vh, 64px);
  }

  .arch-heading {
    margin-bottom: 32px;
  }

  .arch-heading h1 {
    font-size: 1.6rem;
    font-weight: 650;
  }

  /* ---- 轨道与缩进 ---- */
  .tl {
    --tl-rail: 8px; /* 竖线的水平中心 */
    --tl-indent: 28px; /* 标题与条目相对轨道的内缩 */

    position: relative;
    display: flex;
    flex-direction: column;
    gap: 36px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 一条线贯穿所有年份：挂在容器上，与第一个节点中心对齐 */
  .tl::before {
    content: '';
    position: absolute;
    top: 20px;
    bottom: 0;
    left: calc(var(--tl-rail) - 0.5px);
    width: 1px;
    background: var(--c-line);
    pointer-events: none;
  }

  .tl__year {
    position: relative;
  }

  /* 年份标题行：节点垂直对齐靠这里固定的 40px */
  .tl__year-head {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 12px;
    height: 40px;
    padding-left: var(--tl-indent);
  }

  /* 年份节点：1px 描边直角小方块，节点中心 8×8 */
  .tl__year-head::before {
    content: '';
    position: absolute;
    top: 50%;
    left: var(--tl-rail);
    width: 7px;
    height: 7px;
    border: 1px solid var(--c-accent);
    background: var(--c-surface-raised);
    transform: translate(-50%, -50%) rotate(45deg);
    z-index: 1;
  }

  .tl__year-title {
    margin: 0;
    color: var(--c-text);
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 650;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .tl__year-count {
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  /* ---- 条目：time + 标题两列，行底 1px 线，hover 行背景 surface ---- */
  .tl__entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tl__entry {
    margin: 0;
    border-bottom: 1px solid var(--c-line);
  }

  .tl__entry:last-child {
    border-bottom: 0;
  }

  .tl__link {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-left: var(--tl-indent);
    padding: 12px 12px 12px 8px;
    text-decoration: none;
    transition:
      background-color 0.18s var(--c-ease),
      color 0.18s var(--c-ease);
  }

  .tl__link:hover,
  .tl__link:focus-visible {
    background: hsl(var(--surface-2) / 0.7);
    box-shadow: inset 2px 0 0 var(--c-accent);
  }

  .tl__link:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: -2px;
  }

  .tl__date {
    flex: 0 0 52px;
    width: 52px;
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .tl__link:hover .tl__date {
    color: var(--c-accent);
  }

  .tl__title {
    /* min-width: 0 让 flex 子项能真正收缩，否则长标题会把行撑出容器 */
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    color: var(--c-text);
    font-size: 0.95rem;
    font-weight: 620;
    line-height: 1.5;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition: color 0.18s var(--c-ease);
  }

  .tl__link:hover .tl__title,
  .tl__link:focus-visible .tl__title {
    color: var(--c-accent);
  }

  /* ---- 移动端：轨道让位给吸顶年份条 ---- */
  @media (max-width: 760px) {
    .arch-console {
      padding-block: 20px 56px;
    }

    .console-topline {
      gap: 10px;
      font-size: 0.52rem;
    }

    .console-topline-copy {
      display: none;
    }

    .console-topline-rule {
      flex: 1;
      width: auto;
    }

    .tl {
      --tl-indent: 0px;
      gap: 24px;
    }

    /* 竖线与节点一起隐藏：窄屏上 8px 的轨道会把标题挤掉一截 */
    .tl::before,
    .tl__year-head::before {
      display: none;
    }

    .tl__year-head {
      position: sticky;
      /* 顶部导航是 fixed，吸顶条要让开它的高度（--nav-h 由 effects.css 提供） */
      top: var(--nav-h, 80px);
      z-index: 2;
      align-items: center;
      height: 40px;
      margin-inline: 0;
      padding-inline: 0;
      background: hsl(var(--background));
      border-bottom: 1px solid var(--c-line);
    }

    .tl__link {
      margin-left: 0;
      padding-inline: 4px;
      gap: 12px;
    }

    .tl__date {
      flex: 0 0 44px;
      width: 44px;
    }

    .tl__title {
      font-size: 0.88rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl__link {
      transition: none;
    }
  }
</style>
