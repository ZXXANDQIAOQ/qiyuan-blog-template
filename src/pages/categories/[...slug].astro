---
/**
 * 单个分类下的文章 —— ljj-clone-spec §5（/categories/[...slug]）
 *
 * ljj 子页同构：topline（`03 / CATEGORY —— 虚线 —— N 篇`）+ 标题行（分类名 + 描述）
 * + 子分类导航（可选）+ 三列行式索引列表（PostIndexList）。
 *
 * 分类描述的数据来源：先查 i18n 内容表、再落回 site.yaml，两处都没有就不渲染。
 * 数据获取逻辑照旧（getStaticPaths / getPostsByCategory 不动），只换视觉结构。
 */
import CategoryPostList from '@components/category/CategoryPostList.astro';
import { seoConfig, siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import {
  buildCategoryPath,
  getCategoryByLink,
  getCategoryLinks,
  getCategoryList,
  getCategoryNameByLink,
  getPostsByCategory,
  translateCategoryName,
} from '@lib/content';
import { toPostCardDataList } from '@lib/content/transforms';
import { getContentFeaturedCategoryField } from '@/i18n/content';
import { defaultLocale, getLocaleFromUrl, localizedPath, t } from '@/i18n';
import '@styles/components/console-pages.css';

export async function getStaticPaths() {
  const { categories } = await getCategoryList(defaultLocale);
  const links = getCategoryLinks(categories, '');
  return links.map((link) => {
    const category = getCategoryByLink(categories, link);
    return {
      params: { slug: link },
      props: { category },
    };
  });
}

const { category: propCategory } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const { categories: allCategories, countMap } = await getCategoryList(locale);

/** 重新用 locale 感知的数据推一次 category（[lang] 镜像渲染时 countMap 不同源） */
const slug = Astro.params.slug ?? '';
const category = slug ? getCategoryByLink(allCategories, slug) : propCategory;

const currentName = translateCategoryName(category?.name ?? '', locale);

/** 文章列表转成轻量 PostCardData（PostIndexList 契约） */
const posts = category ? await getPostsByCategory(category.name, locale) : [];
const postCards = toPostCardDataList(posts, locale);

/** 当前分类从根到自身的名称链，子分类导航要用它拼完整路径 */
const segments = slug.split('/').filter(Boolean);
const ancestorNames = segments.slice(0, -1).map((_, i) => getCategoryNameByLink(segments[i]));
const categoryNames = [...ancestorNames, category?.name ?? ''].filter(Boolean);

/** 先 i18n 内容表、再 site.yaml；两处都没有返回空串（此段不渲染） */
const description =
  getContentFeaturedCategoryField(locale, slug, 'description') ??
  siteConfig.featuredCategories?.find((item) => item.link === slug)?.description ??
  '';
---

<Layout title={`${t(locale, 'category.postsInCategory', { name: currentName })} | ${seoConfig.title}`} description={description || currentName}>
  <section class="cat-console">
    <div class="section-shell">
      <header class="console-topline">
        <span class="console-topline-index">03 / CATEGORY</span>
        <span class="console-topline-rule"></span>
        <span class="console-topline-copy">{ancestorNames.map((name) => translateCategoryName(name, locale)).join(' / ') || 'INDEX OF TOPICS'}</span>
        <span class="console-topline-status"><i></i>{t(locale, 'category.postCountShort', { count: posts.length })}</span>
      </header>

      <div class="console-heading cat-heading">
        <h1>{currentName}</h1>
        <span class="console-count"><b>{posts.length}</b></span>
      </div>

      {description && <p class="cat-desc">{description}</p>}

      <CategoryPostList
        category={category}
        categoryNames={categoryNames}
        posts={postCards}
        countMap={countMap}
      />
    </div>
  </section>
</Layout>

<style>
  .cat-console {
    padding-block: 22px 72px;
  }

  .cat-console :global(.console-topline) {
    margin-bottom: clamp(36px, 6vh, 64px);
  }

  .cat-heading {
    margin-bottom: 12px;
  }

  .cat-heading h1 {
    font-size: 1.6rem;
    font-weight: 650;
  }

  .cat-desc {
    max-width: 68ch;
    margin: 0 0 24px;
    color: hsl(var(--muted-foreground));
    font-size: 0.86rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .cat-console {
      padding-block: 20px 56px;
    }

    .console-topline {
      gap: 10px;
      font-size: 0.52rem;
    }

    .console-topline-copy {
      display: none;
    }

    .console-topline-rule {
      flex: 1;
      width: auto;
    }
  }
</style>
