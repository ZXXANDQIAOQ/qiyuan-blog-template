---
/**
 * 所有分类 —— ljj-clone-spec §5（/categories）
 *
 * ljj 子页同构：topline（`03 / CATEGORY —— 虚线 —— 统计`）+ 标题行 + 行式索引列表。
 * 旧的 Cover / TwoColumnLayout / HomeSider / Breadcrumb 组合退役 —— ljj 没有
 * 右侧栏，也不需要 220px Hero；CategoryList 本身已是 1px 线分隔的行式列表，
 * 直保留，只把外层壳换成 console。
 */
import CategoryList from '@components/category/CategoryList.astro';
import { seoConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import { getCategoryLinks, getCategoryList } from '@lib/content';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import '@styles/components/console-pages.css';

const locale = getLocaleFromUrl(Astro.url.pathname);
const { categories, countMap } = await getCategoryList(locale);

/** 分类总数含各级子分类 —— 用户点进来要的正是「这里一共有多少个入口」 */
const totalCount = getCategoryLinks(categories, '').length;
---

<Layout
  title={`${t(locale, 'category.allCategories')} | ${seoConfig.title}`}
  description={t(locale, 'category.allCategories')}
>
  <section class="cat-console">
    <div class="section-shell">
      <header class="console-topline">
        <span class="console-topline-index">03 / CATEGORY</span>
        <span class="console-topline-rule"></span>
        <span class="console-topline-copy">INDEX OF TOPICS</span>
        <span class="console-topline-status"><i></i>{t(locale, 'category.totalCategories', { count: totalCount })}</span>
      </header>

      <div class="console-heading cat-heading">
        <h1>{t(locale, 'category.allCategories')}</h1>
        <span class="console-count"><b>{String(totalCount).padStart(2, '0')}</b></span>
      </div>

      <CategoryList categories={categories} countMap={countMap} totalCount={totalCount} />
    </div>
  </section>
</Layout>

<style>
  .cat-console {
    padding-block: 22px 72px;
  }

  .cat-console :global(.console-topline) {
    margin-bottom: clamp(36px, 6vh, 64px);
  }

  .cat-heading {
    margin-bottom: 28px;
  }

  .cat-heading h1 {
    font-size: 1.6rem;
    font-weight: 650;
  }

  @media (max-width: 760px) {
    .cat-console {
      padding-block: 20px 56px;
    }

    .console-topline {
      gap: 10px;
      font-size: 0.52rem;
    }

    .cat-console :global(.console-topline-copy) {
      display: none;
    }

    .cat-console :global(.console-topline-rule) {
      flex: 1;
      width: auto;
    }
  }
</style>
