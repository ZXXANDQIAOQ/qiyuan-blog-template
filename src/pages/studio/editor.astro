---
/**
 * Studio 后台 —— 文章编辑器
 *
 * 同一个页面承担「新建」与「编辑」：
 *   /studio/posts/new      → 新建
 *   /studio/posts/<slug>   → 编辑
 *
 * 为什么它是静态路由 /studio/editor 而不是动态路由 [slug]
 * -------------------------------------------------------
 * 后台的 slug 只有运行时才知道（用户在编辑器里输入），构建期无从枚举，
 * 所以不能用 [slug] 动态路由预渲染。此前的做法是让 getStaticPaths() 返回
 * 空数组，再靠边缘函数兜底返回页面 —— 但 Cloudflare Pages 的 Functions
 * 只处理 /api/studio/*，没有页面兜底能力，导致 /studio/posts/<slug> 直接 404。
 *
 * 现在的做法：
 *   1. 编辑器固定构建成一个静态页面 /studio/editor/
 *   2. public/_redirects 用 200 rewrite 把 /studio/posts/:slug 指向它
 *      （rewrite 不改变浏览器地址栏，所以 location.pathname 仍是原路径，
 *        前端照旧从 pathname 解析 slug，逻辑无需改动）
 *
 * fetch 路径已与 Cloudflare Pages Functions 后端冻结契约对齐
 * （/api/studio/posts?slug=、/api/studio/posts/:slug、/api/studio/upload）。
 */

import StudioLayout from '@layouts/StudioLayout.astro';
---

<StudioLayout title="写新文章 · 内容后台" description="烁烁内容后台编辑器，仅站长使用。">
  <div class="flex min-h-screen flex-col">
    <header class="studio-topbar">
      <div class="flex items-center gap-3">
        <a class="studio-btn no-underline" href="/studio/posts">返回</a>
        <h1 id="page-title" class="m-0 text-[15px] font-medium">写新文章</h1>
      </div>
      <div class="flex items-center gap-2">
        <span id="save-state" class="text-[12px] opacity-65" aria-live="polite"></span>
        <button
          id="save-btn"
          class="studio-btn studio-btn-primary"
          type="button"
          aria-keyshortcuts="Control+S Meta+S"
        >
          保存
        </button>
      </div>
    </header>

    <p id="banner" class="studio-banner-error mx-4 mt-3 hidden sm:mx-6" role="alert"></p>

    <!-- 本地草稿恢复条：浏览器意外关闭/刷新时不丢稿 -->
    <div id="draft-bar" class="mx-4 mt-3 hidden items-center gap-3 sm:mx-6" role="status">
      <span id="draft-text" class="grow text-[13px] opacity-80"></span>
      <button id="draft-restore" class="studio-btn" type="button">恢复草稿</button>
      <button id="draft-discard" class="studio-btn" type="button">丢弃</button>
    </div>

    <div class="grid grow grid-cols-1 gap-0 lg:grid-cols-2">
      <div class="flex flex-col gap-3 p-4 sm:p-6">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5">
            <span class="text-[13px] opacity-70">标题</span>
            <input id="f-title" class="studio-input" type="text" placeholder="文章标题" />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-[13px] opacity-70">URL 短名（slug）</span>
            <input
              id="f-slug"
              class="studio-input"
              type="text"
              placeholder="仅字母、数字、短横线"
              autocomplete="off"
            />
          </label>
        </div>

        <label class="flex flex-col gap-1.5">
          <span class="text-[13px] opacity-70">摘要（可选）</span>
          <textarea
            id="f-description"
            class="studio-input"
            rows="2"
            placeholder="一两句话概括这篇文章"></textarea>
        </label>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5">
            <span class="text-[13px] opacity-70">发布日期</span>
            <input id="f-date" class="studio-input" type="date" />
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="text-[13px] opacity-70">分类（逗号分隔）</span>
            <input id="f-categories" class="studio-input" type="text" placeholder="笔记, 工具" />
          </label>
        </div>

        <label class="flex flex-col gap-1.5">
          <span class="text-[13px] opacity-70">标签（逗号分隔）</span>
          <input id="f-tags" class="studio-input" type="text" placeholder="Astro, 前端" />
        </label>

        <div class="flex flex-col gap-1.5">
          <span class="text-[13px] opacity-70">封面图（可选）</span>
          <div class="flex items-center gap-2">
            <input
              id="f-cover"
              class="studio-input"
              type="text"
              placeholder="/img/cover/1.webp 或点「上传」"
            />
            <label class="studio-btn studio-upload-btn">
              上传
              <input id="f-cover-file" class="hidden" type="file" accept="image/*" />
            </label>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-5 pt-1">
          <label class="studio-checkbox">
            <input id="f-draft" type="checkbox" />
            <span>存为草稿（不在网站上显示）</span>
          </label>
          <label class="studio-checkbox">
            <input id="f-sticky" type="checkbox" />
            <span>置顶</span>
          </label>
        </div>

        <p class="m-0 text-[12px] opacity-65">草稿只存在后台，发布时会被跳过，网站上看不到。</p>

        <div class="flex grow flex-col gap-1.5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-[13px] opacity-70">正文（Markdown）</span>
            <div id="md-toolbar" class="studio-toolbar" role="toolbar" aria-label="Markdown 快捷插入">
              <button class="studio-tb-btn" type="button" data-act="h2" title="二级标题">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 5.5v13M12.5 5.5v13M3.5 12h9"></path><path d="M17 10.5a2.6 2.6 0 0 1 4 2.1c0 1.2-.9 2-1.9 3l-2.1 2h4"></path></svg>
              </button>
              <button class="studio-tb-btn" type="button" data-act="bold" title="加粗（Ctrl+B）">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 5h6a3.5 3.5 0 0 1 0 7H7z"></path><path d="M7 12h7a3.5 3.5 0 0 1 0 7H7z"></path></svg>
              </button>
              <button class="studio-tb-btn" type="button" data-act="italic" title="斜体（Ctrl+I）">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 5h8M6 19h8M14.5 5l-5 14"></path></svg>
              </button>
              <button class="studio-tb-btn" type="button" data-act="quote" title="引用">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5.5v13"></path><path d="M10 8h9M10 12h9M10 16h6"></path></svg>
              </button>
              <button class="studio-tb-btn" type="button" data-act="code" title="行内代码">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.6 7L4 12l4.6 5"></path><path d="M15.4 7L20 12l-4.6 5"></path></svg>
              </button>
              <button class="studio-tb-btn" type="button" data-act="link" title="链接">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.2 13.8a4 4 0 0 0 5.6 0l3-3a4 4 0 0 0-5.6-5.6l-1.5 1.5"></path><path d="M13.8 10.2a4 4 0 0 0-5.6 0l-3 3a4 4 0 0 0 5.6 5.6l1.5-1.5"></path></svg>
              </button>
              <button class="studio-tb-btn" type="button" data-act="ul" title="无序列表">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 6.5H20M9.5 12H20M9.5 17.5H14"></path><circle cx="5.4" cy="6.5" r="1.1" fill="currentColor" stroke="none"></circle><circle cx="5.4" cy="12" r="1.1" fill="currentColor" stroke="none"></circle><circle cx="5.4" cy="17.5" r="1.1" fill="currentColor" stroke="none"></circle></svg>
              </button>
              <button class="studio-tb-btn" type="button" data-act="img" title="插入图片">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2.4"></rect><circle cx="9" cy="10" r="1.6"></circle><path d="M4.5 17l4.5-4.5 3.5 3.5 3-3 4 4"></path></svg>
              </button>
            </div>
          </div>
          <textarea
            id="f-body"
            class="studio-input studio-input-mono grow"
            placeholder="在这里写 Markdown。支持 GFM、代码块、数学公式，右侧边写边预览。"></textarea>
        </div>

        <p class="m-0 text-[12px] opacity-65">
          点「保存」只是存好；回到文章列表点「发布到网站」，改动才会显示到网站上。编辑过程中会自动留一份草稿在本浏览器，意外关页也不怕。
        </p>
      </div>

      <div
        class="border-t p-4 sm:p-6 lg:border-t-0 lg:border-l"
        style="border-color: var(--color-border-tertiary, rgba(0, 0, 0, 0.12))"
      >
        <p class="mt-0 mb-3 text-[13px] opacity-70">预览</p>
        <article id="preview" class="prose prose-sm max-w-none" style="overflow-wrap: break-word">
        </article>
      </div>
    </div>
  </div>
</StudioLayout>

<script>
  import { marked } from 'marked';
  import sanitizeHtml from 'sanitize-html';

  // PostData 字段与 site-spec.md §5.0 冻结一致
  interface PostData {
    slug?: string;
    title?: string;
    description?: string;
    date?: string;
    tags?: string[];
    categories?: string[];
    cover?: string;
    draft?: boolean;
    sticky?: boolean;
    body?: string;
  }

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const titleEl = el<HTMLInputElement>('f-title');
  const slugEl = el<HTMLInputElement>('f-slug');
  const descEl = el<HTMLTextAreaElement>('f-description');
  const dateEl = el<HTMLInputElement>('f-date');
  const catEl = el<HTMLInputElement>('f-categories');
  const tagEl = el<HTMLInputElement>('f-tags');
  const coverEl = el<HTMLInputElement>('f-cover');
  const coverFileEl = el<HTMLInputElement>('f-cover-file');
  const draftEl = el<HTMLInputElement>('f-draft');
  const stickyEl = el<HTMLInputElement>('f-sticky');
  const bodyEl = el<HTMLTextAreaElement>('f-body');
  const previewEl = el<HTMLElement>('preview');
  const bannerEl = el<HTMLElement>('banner');
  const saveBtn = el<HTMLButtonElement>('save-btn');
  const saveState = el<HTMLElement>('save-state');
  const pageTitle = el<HTMLElement>('page-title');

  // /studio/posts/<slug>  → ['studio','posts','<slug>']，slug 固定在第 3 段（索引 2）
  // /studio/posts/new      → 新建
  // 注意：原先用 pathParts[3] 是错的（标准路径只有 3 段），会把所有编辑请求
  // 都误判为「新建」，导致编辑已有文章时表单空白。
  const pathParts = window.location.pathname.split('/').filter(Boolean);
  const editingSlug =
    pathParts.length >= 3 && pathParts[1] === 'posts' ? decodeURIComponent(pathParts[2]) : null;
  const isNew = !editingSlug || editingSlug === 'new';

  let dirty = false;
  let saving = false;
  let loaded = false;

  function showError(message: string) {
    if (!bannerEl) return;
    bannerEl.textContent = message;
    bannerEl.classList.remove('hidden');
    window.setTimeout(() => bannerEl.classList.add('hidden'), 7000);
  }

  function markDirty() {
    dirty = true;
    if (loaded && saveState) saveState.textContent = '未保存';
  }

  function slugify(input: string) {
    return input
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 80);
  }

  function renderPreview() {
    if (!previewEl || !bodyEl) return;
    const raw = bodyEl.value;
    const html = marked.parse(raw, { async: false }) as string;
    previewEl.innerHTML = sanitizeHtml(html, {
      allowedTags: sanitizeHtml.defaults.allowedTags.concat([
        'img',
        'h1',
        'h2',
        'del',
        'input',
        'details',
        'summary',
      ]),
      allowedAttributes: {
        ...sanitizeHtml.defaults.allowedAttributes,
        img: ['src', 'alt', 'title', 'width', 'height', 'loading'],
        a: ['href', 'title', 'target', 'rel'],
        input: ['type', 'checked', 'disabled'],
      },
      allowedSchemes: ['http', 'https', 'mailto', 'data'],
    });
  }

  function fillForm(post: PostData) {
    if (titleEl) titleEl.value = post.title ?? '';
    if (slugEl) slugEl.value = post.slug ?? '';
    if (descEl) descEl.value = post.description ?? '';
    if (dateEl) dateEl.value = (post.date ?? new Date().toISOString().slice(0, 10)).slice(0, 10);
    if (catEl) catEl.value = (post.categories ?? []).join(', ');
    if (tagEl) tagEl.value = (post.tags ?? []).join(', ');
    if (coverEl) coverEl.value = post.cover ?? '';
    if (draftEl) draftEl.checked = post.draft === true;
    if (stickyEl) stickyEl.checked = post.sticky === true;
    if (bodyEl) bodyEl.value = post.body ?? '';
    renderPreview();
  }

  // collect() 不发送 updated/createdAt，服务端自行补全（site-spec.md §5.0）
  function collect(): PostData {
    const splitList = (value: string) =>
      value
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean);

    return {
      slug: slugEl?.value.trim() ?? '',
      title: titleEl?.value.trim() ?? '',
      description: descEl?.value.trim() ?? '',
      date: dateEl?.value ?? new Date().toISOString().slice(0, 10),
      categories: splitList(catEl?.value ?? ''),
      tags: splitList(tagEl?.value ?? ''),
      cover: coverEl?.value.trim() ?? '',
      draft: draftEl?.checked === true,
      sticky: stickyEl?.checked === true,
      body: bodyEl?.value ?? '',
    };
  }

  async function save() {
    if (saving) return;

    const data = collect();

    if (!data.title) {
      showError('先给文章起个标题。');
      titleEl?.focus();
      return;
    }

    const slug = slugEl?.value.trim() || slugify(data.title);
    if (!/^[a-z0-9][a-z0-9-_]*$/i.test(slug)) {
      showError('URL 短名只能用字母、数字、短横线和下划线。');
      slugEl?.focus();
      return;
    }
    if (slugEl) slugEl.value = slug;

    saving = true;
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = '保存中…';
    }
    if (saveState) saveState.textContent = '保存中…';

    try {
      // POST /api/studio/posts?slug=...（site-spec.md §8 零改动，注意是 POST + query）
      const res = await fetch(`/api/studio/posts?slug=${encodeURIComponent(slug)}`, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.status === 401) {
        window.location.replace('/studio');
        return;
      }

      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(body?.error || `保存失败（${res.status}）`);
        if (saveState) saveState.textContent = '保存失败';
        return;
      }

      dirty = false;
      if (saveState) saveState.textContent = '已保存';
      // 保存成功：这份内容的本地草稿使命完成
      try {
        localStorage.removeItem(draftKey);
      } catch {}

      // 新建成功后换成编辑态的 URL，避免刷新又变成新建
      if (isNew) {
        window.history.replaceState(null, '', `/studio/posts/${encodeURIComponent(slug)}`);
        if (pageTitle) pageTitle.textContent = '编辑文章';
      }
    } catch {
      showError('网络断了，检查网络后重试。');
      if (saveState) saveState.textContent = '保存失败';
    } finally {
      saving = false;
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = '保存';
      }
    }
  }

  async function load() {
    if (isNew) {
      loaded = true;
      await maybeOfferDraftRestore();
      return;
    }
    try {
      // GET /api/studio/posts/:slug（site-spec.md §8 零改动）
      const res = await fetch(`/api/studio/posts/${encodeURIComponent(editingSlug as string)}`, {
        credentials: 'same-origin',
      });
      if (res.status === 401) {
        window.location.replace('/studio');
        return;
      }
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(body?.error ? `文章没读出来（${body.error}），返回列表看看它还在不在。` : `文章没读出来（${res.status}），返回列表看看它还在不在。`);
        return;
      }
      fillForm(body.post ?? {});
      if (pageTitle) pageTitle.textContent = '编辑文章';
      await maybeOfferDraftRestore();
    } catch {
      showError('网络断了，文章加载不出来。');
    } finally {
      loaded = true;
    }
  }

  // --- Markdown 工具栏 ---
  // 所有操作都基于 textarea 的选区：能撤销（浏览器原生 undo 栈），不重排光标。
  const toolbar = el<HTMLElement>('md-toolbar');

  function applyAction(act: string) {
    if (!bodyEl) return;
    const { selectionStart: s, selectionEnd: e, value } = bodyEl;
    const sel = value.slice(s, e);

    // 行首前缀：找到选区起点所在行行首
    const lineStart = value.lastIndexOf('\n', s - 1) + 1;

    const replace = (text: string, cursorOffset?: number | [number, number]) => {
      bodyEl.setRangeText(text, s, e, 'end');
      if (typeof cursorOffset === 'number') {
        bodyEl.selectionStart = bodyEl.selectionEnd = s + cursorOffset;
      } else if (Array.isArray(cursorOffset)) {
        bodyEl.selectionStart = s + cursorOffset[0];
        bodyEl.selectionEnd = s + cursorOffset[1];
      }
      bodyEl.focus();
      markDirty();
      renderPreview();
    };

    switch (act) {
      case 'h2':
        // 在行首插入「## 」
        bodyEl.setRangeText('## ', lineStart, lineStart, 'end');
        break;
      case 'bold':
        replace(sel ? `**${sel}**` : '****', sel ? undefined : [2, 2]);
        break;
      case 'italic':
        replace(sel ? `*${sel}*` : '**', sel ? undefined : [1, 1]);
        break;
      case 'quote': {
        // 选区内每一行都加「> 」
        const block = value.slice(lineStart, Math.max(e, s));
        const quoted = block
          .split('\n')
          .map((l) => (l.startsWith('> ') ? l : `> ${l}`))
          .join('\n');
        bodyEl.setRangeText(quoted, lineStart, Math.max(e, s), 'end');
        break;
      }
      case 'code':
        replace(sel ? `\`${sel}\`` : '``', sel ? undefined : [1, 1]);
        break;
      case 'link':
        replace(`[${sel || '链接文字'}](url)`, sel ? undefined : [1, 5]);
        break;
      case 'ul':
        bodyEl.setRangeText('- ', lineStart, lineStart, 'end');
        break;
      case 'img':
        replace(`![图片描述](url)`, [2, 6]);
        break;
      default:
        return;
    }
    bodyEl.focus();
    markDirty();
    renderPreview();
  }

  toolbar?.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
    if (btn) applyAction(btn.dataset.act as string);
  });

  // --- 本地自动草稿 ---
  // 为什么存 localStorage：KV 是「保存」动作的远端存储，但写作中途误关
  // 标签页时内容还没保存过。草稿只存本浏览器（含全部表单字段 + 时间），
  // 保存到后台成功后即清除，恢复条只在草稿与当前内容不一致时出现。
  const draftKey = `studio-draft:${editingSlug ?? 'new'}`;
  const draftBar = el<HTMLElement>('draft-bar');
  const draftText = el<HTMLElement>('draft-text');

  let draftTimer: number | undefined;

  function saveDraft() {
    try {
      localStorage.setItem(
        draftKey,
        JSON.stringify({ data: collect(), savedAt: Date.now() }),
      );
    } catch {
      // 隐私模式存储配额满等场景：草稿失败不影响编辑
    }
  }

  function scheduleDraft() {
    window.clearTimeout(draftTimer);
    draftTimer = window.setTimeout(saveDraft, 1200);
  }

  function timeAgo(ts: number) {
    const mins = Math.max(1, Math.round((Date.now() - ts) / 60000));
    return mins < 60 ? `${mins} 分钟前` : `${Math.round(mins / 60)} 小时前`;
  }

  async function maybeOfferDraftRestore() {
    try {
      const raw = localStorage.getItem(draftKey);
      if (!raw) return;
      const { data, savedAt } = JSON.parse(raw) as { data: PostData; savedAt: number };
      // 草稿正文和当前正文一样（刚保存过又回来）就不打扰
      if (!data.body || data.body === bodyEl?.value) {
        localStorage.removeItem(draftKey);
        return;
      }
      if (draftText && draftBar) {
        draftText.textContent = `发现一份本地草稿（${timeAgo(savedAt)}自动保存），比当前内容新。`;
        draftBar.classList.remove('hidden');
        draftBar.classList.add('flex');
        el<HTMLButtonElement>('draft-restore')?.addEventListener('click', () => {
          fillForm(data);
          draftBar.classList.add('hidden');
          markDirty();
        });
        el<HTMLButtonElement>('draft-discard')?.addEventListener('click', () => {
          localStorage.removeItem(draftKey);
          draftBar.classList.add('hidden');
          draftBar.classList.remove('flex');
        });
      }
    } catch {
      // 草稿数据损坏：忽略
    }
  }

  // --- 事件绑定 ---

  for (const node of [titleEl, descEl, dateEl, catEl, tagEl, coverEl]) {
    node?.addEventListener('input', () => {
      markDirty();
      scheduleDraft();
      if (node === titleEl && isNew && slugEl && !slugEl.dataset.touched) {
        slugEl.value = slugify(titleEl.value);
      }
    });
  }

  slugEl?.addEventListener('input', () => {
    slugEl.dataset.touched = '1';
    markDirty();
  });

  for (const node of [draftEl, stickyEl]) {
    node?.addEventListener('change', markDirty);
  }

  bodyEl?.addEventListener('input', () => {
    markDirty();
    renderPreview();
    scheduleDraft();
  });

  saveBtn?.addEventListener('click', save);

  coverFileEl?.addEventListener('change', async () => {
    const file = coverFileEl.files?.[0];
    if (!file) return;

    const form = new FormData();
    form.append('file', file);

    if (saveState) saveState.textContent = '上传中…';
    try {
      // POST /api/studio/upload（site-spec.md §8 零改动）
      const res = await fetch('/api/studio/upload', {
        method: 'POST',
        credentials: 'same-origin',
        body: form,
      });
      if (res.status === 401) {
        window.location.replace('/studio');
        return;
      }
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(body?.error ? `图片没传上去，${body.error}。` : '图片没传上去，换个文件或稍后再试。');
        return;
      }
      if (coverEl && body.url) {
        coverEl.value = body.url;
        markDirty();
      }
    } catch {
      showError('图片没传上去，网络断了。');
    } finally {
      if (saveState) saveState.textContent = dirty ? '未保存' : '已保存';
      coverFileEl.value = '';
    }
  });

  // 快捷键：Ctrl/Cmd + S 保存；+ B/I 加粗/斜体（编辑器内生效）
  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 's') {
      event.preventDefault();
      save();
      return;
    }
    if ((event.ctrlKey || event.metaKey) && document.activeElement === bodyEl) {
      const key = event.key.toLowerCase();
      if (key === 'b') {
        event.preventDefault();
        applyAction('bold');
      } else if (key === 'i') {
        event.preventDefault();
        applyAction('italic');
      }
    }
  });

  // 有未保存改动时离开给出提示
  window.addEventListener('beforeunload', (event) => {
    if (!dirty) return;
    event.preventDefault();
    event.returnValue = '';
  });

  load();
</script>
