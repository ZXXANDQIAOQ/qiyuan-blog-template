---
/**
 * 标签总览 —— ljj-clone-spec §5（/tags）
 *
 * ljj 子页同构：topline（`04 / TAG —— 虚线 —— 共 N 个标签`）+ 标题行 +
 * 行式索引列表。旧的芯片墙（四色轮转 / 青描边分档）与折叠区退役 ——
 * 规格要求列表统一为 1px 线分隔的行式索引：每行 mono `#标签` + 右对齐计数，
 * hover 标签变锈红、行背景 surface。
 *
 * 单次出现的标签不再折叠：行式列表一屏能扫完，折叠交互反而藏信息。
 */
import { seoConfig, siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import { buildTagPath, getAllTags, getSortedPosts } from '@lib/content';
import { getLocaleFromUrl, localizedPath, t } from '@/i18n';
import '@styles/components/console-pages.css';

const locale = getLocaleFromUrl(Astro.url.pathname);
const posts = await getSortedPosts(locale);
const tags = getAllTags(posts);

/** 数量降序；同数量保持首次出现顺序（构建期稳定） */
const sortedTags = Object.entries(tags)
  .sort(([, a], [, b]) => b - a)
  .map(([tag, count]) => ({ tag, count }));

const tagHref = (tag: string) => localizedPath(buildTagPath(tag), locale);
---

<Layout title={`${t(locale, 'tag.allTags')} | ${siteConfig.title}`} description={t(locale, 'tag.allTags')}>
  <section class="tag-console">
    <div class="section-shell">
      <header class="console-topline">
        <span class="console-topline-index">04 / TAG</span>
        <span class="console-topline-rule"></span>
        <span class="console-topline-copy">ALL TOPICS</span>
        <span class="console-topline-status"><i></i>{t(locale, 'tag.totalTags', { count: sortedTags.length })}</span>
      </header>

      <div class="console-heading tag-heading">
        <h1>{t(locale, 'tag.allTags')}</h1>
        <span class="console-count"><b>{String(sortedTags.length).padStart(2, '0')}</b></span>
      </div>

      <ul class="tag-index-list">
        {
          sortedTags.map(({ tag, count }) => (
            <li>
              <a href={tagHref(tag)} data-astro-prefetch="hover">
                <span class="tag-index-mark" aria-hidden="true">#</span>
                <strong>{tag}</strong>
                <span class="tag-index-count">{t(locale, 'tag.postCount', { count })}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .tag-console {
    padding-block: 22px 72px;
  }

  .console-topline {
    margin-bottom: clamp(36px, 6vh, 64px);
  }

  .tag-heading {
    margin-bottom: 20px;
  }

  .tag-heading h1 {
    font-size: 1.6rem;
    font-weight: 650;
  }

  /* 行式标签索引：mono `#tag` + 右对齐计数，1px 线分隔，直角 */
  .tag-index-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-index-list li {
    border-bottom: 1px solid var(--c-line);
  }

  .tag-index-list a {
    position: relative;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: baseline;
    min-height: 48px;
    align-content: center;
    padding: 10px 8px 10px 0;
    text-decoration: none;
    transition:
      background-color 0.18s var(--c-ease),
      color 0.18s var(--c-ease);
  }

  .tag-index-list a:hover,
  .tag-index-list a:focus-visible {
    background: hsl(var(--surface-2) / 0.7);
    box-shadow: inset 2px 0 0 var(--c-accent);
  }

  .tag-index-list a:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: -2px;
  }

  .tag-index-mark {
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    transition: color 0.18s var(--c-ease);
  }

  .tag-index-list strong {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--c-text);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 620;
    line-height: 1.4;
    transition: color 0.18s var(--c-ease);
  }

  .tag-index-list a:hover strong,
  .tag-index-list a:hover .tag-index-mark,
  .tag-index-list a:focus-visible strong {
    color: var(--c-accent);
  }

  .tag-index-count {
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-align: right;
  }

  @media (max-width: 760px) {
    .tag-console {
      padding-block: 20px 56px;
    }

    .console-topline {
      gap: 10px;
      font-size: 0.52rem;
    }

    .console-topline-copy {
      display: none;
    }

    .console-topline-rule {
      flex: 1;
      width: auto;
    }
  }
</style>
