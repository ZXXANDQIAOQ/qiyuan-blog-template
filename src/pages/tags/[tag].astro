---
/**
 * 单个标签下的文章 —— ljj-clone-spec §5（/tags/[tag]）
 *
 * ljj 子页同构：topline（`04 / TAG —— 虚线 —— N 篇`）+ 标题行（`#标签`）
 * + 三列行式索引列表（PostIndexList，行内第三列显示分类）。
 *
 * 与旧版的差异：不再复用 <PostList> 横向卡 —— ljj 子页统一行式索引；
 * 标签页不分页，一次列完（showPaginator 语义保留为「不渲染分页器」）。
 * 数据获取逻辑照旧。
 */
import PostIndexList from '@components/post/PostIndexList.astro';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import { getSortedPosts, normalizeTag } from '@lib/content';
import { toPostCardDataList } from '@lib/content/transforms';
import { defaultLocale, getLocaleFromUrl, localizedPath, t } from '@/i18n';
import '@styles/components/console-pages.css';

/** 「← 全部」回链 */
const tBackHref = (loc: string) => localizedPath('/tags', loc);

export async function getStaticPaths() {
  const posts = await getSortedPosts(defaultLocale);
  const tags = new Set<string>();

  for (const post of posts) {
    const postTags = post.data.tags || [];
    for (const tag of postTags) {
      tags.add(normalizeTag(tag));
    }
  }

  return Array.from(tags).map((tag) => ({
    params: { tag: normalizeTag(tag).replace(/\//g, '-') },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const allPosts = await getSortedPosts(locale);
const posts = allPosts.filter((post) => post.data.tags?.some((tg) => normalizeTag(tg) === tag));

/** PostIndexList 吃轻量 PostCardData，在这里一次性转好 */
const postCardData = toPostCardDataList(posts, locale);
---

<Layout title={`${t(locale, 'tag.postsWithTag', { name: tag })} | ${siteConfig.title}`} description={t(locale, 'tag.postsWithTag', { name: tag })}>
  <section class="tag-console">
    <div class="section-shell">
      <header class="console-topline">
        <span class="console-topline-index">04 / TAG</span>
        <span class="console-topline-rule"></span>
        <span class="console-topline-copy">TOPIC</span>
        <span class="console-topline-status"><i></i>{t(locale, 'tag.postCount', { count: posts.length })}</span>
      </header>

      <div class="console-heading tag-heading">
        <h1><span class="tag-hash" aria-hidden="true">#</span>{tag}</h1>
        <span class="console-count"><b>{posts.length}</b></span>
      </div>

      <PostIndexList posts={postCardData} locale={locale} />

      <p class="tag-back">
        <a href={tBackHref(locale)}>← {t(locale, 'tag.all')}</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .tag-console {
    padding-block: 22px 72px;
  }

  .console-topline {
    margin-bottom: clamp(36px, 6vh, 64px);
  }

  .tag-heading {
    margin-bottom: 20px;
  }

  .tag-heading h1 {
    font-size: 1.6rem;
    font-weight: 650;
  }

  .tag-hash {
    margin-right: 4px;
    color: var(--c-accent);
    font-family: var(--font-mono);
    font-size: 0.8em;
  }

  .tag-back {
    margin: 26px 0 0;
  }

  .tag-back a {
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 0.18s var(--c-ease);
  }

  .tag-back a:hover,
  .tag-back a:focus-visible {
    color: var(--c-accent);
  }

  @media (max-width: 760px) {
    .tag-console {
      padding-block: 20px 56px;
    }

    .console-topline {
      gap: 10px;
      font-size: 0.52rem;
    }

    .console-topline-copy {
      display: none;
    }

    .console-topline-rule {
      flex: 1;
      width: auto;
    }
  }
</style>
